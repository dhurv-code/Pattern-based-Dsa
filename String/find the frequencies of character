#include <iostream>
#include<unordered_map>
using namespace std;

int main() {
    string s ="abcdefghi";
    unordered_map<char,int>mp;
    for(char c: s){
        mp[c]++;
    }
    for(auto pair:mp){
        cout<<pair.first<<pair.second<<endl;
    }
    return 0;
}


// without using hashmap
#include <iostream>

using namespace std;

int main() {
    string s ="abcdefaghi";
    int freq[26]={0};
    for(int i=0;s[i]!=0;i++){
        freq[s[i]-'a']++;
    }
    for(int i=0;i<26;i++){
        if(freq[i]>0){
            char ch= 'a'+i;
            cout<<ch<< freq[i]<<endl;
        }
    }
    return 0;
}
