
#include <iostream>
using namespace std;

int main() {
    string s= "AbcdDFrefFG";
    int upperCase=0;
    int lowerCase=0;
    for(int i=0;i<s[i]!=0;i++){
        char c=s[i];
        if(c>'A'&& c<'Z'){
            upperCase++;
        }
        else if(c>'a'&&c<'z'){
            lowerCase++;
        }
    }
    cout<<upperCase;
    cout<<"\n";
    cout<<lowerCase;
    
    return 0;
}
