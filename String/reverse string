#include <iostream>
using namespace std;

int main() {
    string s= "abcde";
    int len=0;
    while(s[len]!='\0'){
        len++;
    }
    int st=0;
    int end=len-1;
    while(st<end){
        int temp=s[st];
        s[st]=s[end];
        s[end]=temp;
        st++;
        end--;
    }
    cout<<s;
    return 0;
}
