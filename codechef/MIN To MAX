class Solution {
public:
    int countNonMinimum(vector<int>& nums) {
        // write your code here 
        int m=*min_element(nums.begin(),nums.end());
        int count=0;
        for(int i=0;i<nums.size();i++){
            if(nums[i]>m){
                count++;
            }
        }
        return count;
    }
};
