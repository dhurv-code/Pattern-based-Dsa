#include <iostream>
using namespace std;
// #include <iterator>
int main() {
    int nums[]={1,2,3,4};
    int sum=0;
    double avg=0;
    int size = sizeof(nums) / sizeof(nums[0]);
    for(int i=0;i<size;i++){
        sum+=nums[i];
        
    }
    avg=double(sum)/size;
    cout<< avg;
    return 0;
}
