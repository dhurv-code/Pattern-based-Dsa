class Solution {
public:
    bool check(int zero,int one,int two){
        if(one==0){
            return false;
        }
        one--;
        int moves=1+min(one,two)*2+zero;

        if(one>two){
            one--;
            moves++;
        }
        return moves%2==1 && one!=two;

    }
    bool stoneGameIX(vector<int>& stones) {
        int cnt[3]={0};
        for(int x:stones){
            cnt[x%3]++;
        }
        return check(cnt[0],cnt[1],cnt[2])||check(cnt[0],cnt[2],cnt[1]);
    }
};
