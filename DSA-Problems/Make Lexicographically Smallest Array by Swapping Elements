class Solution {
public:
    vector<int> lexicographicallySmallestArray(vector<int>& nums, int limit) {
        int n=nums.size();
        vector<pair<int,int>> sorted_vals(n);
        for(int i=0;i<n;i++){
            sorted_vals[i]={nums[i],i};
        }
        sort(sorted_vals.begin(), sorted_vals.end());
        vector<int>result(n);

        int i=0;
        while(i<n){
            int j=i;
            while(j+1<n && sorted_vals[j+1].first-sorted_vals[j].first<=limit){
                j++;
            }
            vector<int>groupIndices;
            for(int t=i;t<=j;t++){
                groupIndices.push_back(sorted_vals[t].second);
            }
            sort(groupIndices.begin(),groupIndices.end());
            for(int t=i;t<=j;t++){
                result[groupIndices[t - i]] = sorted_vals[t].first;
            }
            i=j+1;
        }
        return result;
    }
};
