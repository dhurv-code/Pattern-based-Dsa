class Solution {
public:
    int minSwaps(vector<int>& nums) {
        int n=nums.size();
        vector<pair<pair<int, int>, int>> vec(n);
        for(int i=0;i<n;i++){
            int val = nums[i];
            int sum = 0;
            while(val>0){
                int digit=val%10;
                sum=sum+digit;
                val/=10;
            }
            vec[i] = {{sum, nums[i]}, i};            
        }
        sort(vec.begin(), vec.end());

// Count permutation cycles for minimum swaps
        vector<bool>visited(n,false);
        int swaps=0;

        for(int i=0;i<n;i++){
            if (visited[i] || vec[i].second == i) {
                continue;
            }
            int cycle_size = 0;
            int curr = i;

            while(!visited[curr]){
                visited[curr]=true;
                curr=vec[curr].second;
                cycle_size++;
            }

            if(cycle_size>0){
                swaps+=(cycle_size-1);
            }
        }
        return swaps;
    }
};
