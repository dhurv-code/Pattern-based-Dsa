class Solution {
public:
    bool hasValidPath(vector<vector<char>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        if ((m + n) % 2 == 0) return false;
        if (grid[0][0] == ')' || grid[m-1][n-1] == '(')
            return false;

        vector<vector<vector<bool>>> dp(
            m, vector<vector<bool>>(
                n, vector<bool>(m + n, false)
            )
        );

        dp[0][0][1] = true;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                for (int b = 0; b < m + n; b++) {
                    if (!dp[i][j][b]) continue;

                    // Move down or right
                    for (auto [di, dj] : vector<pair<int,int>>{{1,0}, {0,1}}) {
                        int ni = i + di;
                        int nj = j + dj;

                        if (ni >= m || nj >= n) continue;

                        int nb = b + (grid[ni][nj] == '(' ? 1 : -1);

                        if (nb >= 0 && nb < m + n) {
                            dp[ni][nj][nb] = true;
                        }
                    }
                }
            }
        }

        return dp[m-1][n-1][0];
    }
};
