class Solution {
public:
    int sortPermutation(vector<int>& nums) {
        int k=-1;
        bool isSorted=true;
        for(int i=0;i<nums.size();i++){
            if(nums[i]!=i){
                isSorted=false;
                k&=nums[i];
            }
        }
        return isSorted?0:k;
    }
};
