class Solution:
    def evaluate(self, s: str, knowledge: List[List[str]]) -> str:
        kmap = {k: v for k, v in knowledge}
        result = []
        i = 0
        n = len(s)
        while i < n:
            if s[i] == '(':
                j = s.find(')', i)
                key = s[i+1:j]
                result.append(kmap.get(key, '?'))
                i = j + 1
            else:
                result.append(s[i])
                i += 1
        return ''.join(result)
