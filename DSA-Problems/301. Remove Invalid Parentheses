class Solution {
public:
    bool isValid(const string &str){
        int count=0;
        for(char c: str){
            if(c=='(') count++;
            else if(c==')'){
                count--;
                if(count<0) return false;
            }
        }
        return count==0;
    }
    vector<string> removeInvalidParentheses(string s) {
        vector<string>result;
        queue<string>q;
        unordered_set<string>visited;

        q.push(s);
        visited.insert(s);
        bool found=false;

        while(!q.empty()){
            string curr=q.front();
            q.pop();

            if(isValid(curr)){
                result.push_back(curr);
                found=true;
            }
            if(found)
                continue;

            for(int i=0;i<curr.length();i++){
                if(curr[i]!='('&& curr[i]!=')') continue;

                string next_state=curr.substr(0,i)+curr.substr(i+1);

                if(visited.find(next_state)==visited.end()){
                    visited.insert(next_state);
                    q.push(next_state);
                }
            }
        }
        return result;

    }
};
