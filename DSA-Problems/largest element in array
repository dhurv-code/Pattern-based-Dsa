#include <iostream>
using namespace std;
// #include <iterator>
int main() {
    int nums[]={1,2,3,4,5,6,7,8,9};
    int maxVal=nums[0];
    int size = sizeof(nums) / sizeof(nums[0]);
    for(int i=1;i<size;i++){
        if(nums[i]>maxVal){
            maxVal=nums[i];
        }
    }
    cout<< maxVal;
    return 0;
}
