class Solution {
public:
    int play(vector<int>& stoneValue,int i, vector<int>&dp){
        int n=stoneValue.size();
        if( i>=n){
            return 0;
        }
        if(dp[i]!=INT_MIN){
            return dp[i];
        }
        int ans=INT_MIN;
        int sum=0;
        for(int k=0;k<3&&i+k<n;k++){
            sum+=stoneValue[i+k];
            ans=max(ans,sum-play(stoneValue,i+k+1,dp));
        }
        return dp[i]=ans;
    }
    string stoneGameIII(vector<int>& stoneValue) {
        int n=stoneValue.size();
        vector<int>dp(n,INT_MIN);
        int diff=play(stoneValue,0,dp);
        if(diff>0)
            return "Alice";
        if(diff<0)
            return "Bob";
        
        return "Tie";
    }
};
