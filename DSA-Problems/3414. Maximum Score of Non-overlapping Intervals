class Solution:
    def maximumWeight(self, intervals: List[List[int]]) -> List[int]:
        n=len(intervals)
        order=sorted(range(n),key=lambda i: intervals[i][1])
        L=[intervals[i][0] for i in order]
        R=[intervals[i][1] for i in order]
        W=[intervals[i][2] for i in order]

        dp=[[(0,()) for _ in range (5)] for _ in range(n+1)]

        for i in range(1,n+1):
            l, w, orig = L[i - 1], W[i - 1], order[i - 1]
            pred = bisect_left(R, l, 0, i - 1)

            for k in range(5):
                best_score, best_tuple = dp[i - 1][k]
                if k >= 1:
                    bs, bt = dp[pred][k - 1]
                    new_score = bs + w
                    new_tuple = tuple(sorted(bt + (orig,)))     # option: take interval i-1
                    if new_score > best_score or (new_score == best_score and new_tuple < best_tuple):
                        best_score, best_tuple = new_score, new_tuple
                dp[i][k] = (best_score, best_tuple)

        return list(dp[n][4][1])
