    class Solution {
    public:
        ListNode* reverseBetween(ListNode* head, int left, int right) {
            ListNode* dummy= new ListNode(0);
            dummy->next=head;
            ListNode* prev= dummy;
            
            for(int i=0;i<left-1;i++){
                prev=prev->next;
            }
            ListNode* curr=prev->next;

            for(int i=0;i<right-left;i++){
                ListNode* then=curr->next;
                curr->next=then->next;
                then->next=prev->next;
                prev->next=then;
            }
            return dummy->next;
        }
    };
