class Solution {
public:
    int missingMultiple(vector<int>& nums, int k) {
        unordered_set<long long> s;
        for (int x : nums) {
            if (x > 0 && x % k == 0) {
                s.insert(x / k);
            }
        }
        
        long long m = 1;
        while (s.count(m)) {
            m++;
        }
        
        return (int)(m * k);
    }
};
