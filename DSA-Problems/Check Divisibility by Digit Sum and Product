class Solution {
public:
    bool checkDivisibility(int n) {
        int original=n;
        int ans=0;
        int sum=0;
        int mul=1;
        while(n>0){
            int digit=n%10;
            sum+=digit;
            mul*=digit;
            n/=10;
        }
        if(original%(sum+mul)!=0){
            return false;
        }
        return true;
    }
};
