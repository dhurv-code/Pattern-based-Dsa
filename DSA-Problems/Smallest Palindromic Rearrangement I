class Solution {
public:
    string smallestPalindrome(string s) {
        vector<int> freq(26,0);
        for(char c:s){
            freq[c-'a']++;
        }

        string left="";
        string right="";
        string middle="";
        //build left
        for(int i=0;i<26;i++){
            int pairs=freq[i]/2;
            while(pairs--){
                left+=char(i+'a');
            }
        }
        // build middle
        for(int i=0;i<26;i++){
            if(freq[i]%2==1){
                middle+=char(i+'a');
            }
        }
        // build right
        right=left;
        reverse(right.begin(),right.end());

        return left+middle+right;
    }
};
