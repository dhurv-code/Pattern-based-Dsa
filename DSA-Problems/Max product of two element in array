class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int largest=0;
        int secondLargest=0;
        int n=nums.size();
       for(int i = 0; i < n; i++){
            if(nums[i]>largest){
                secondLargest=largest;
                largest=nums[i];
            }
            else if(nums[i]>secondLargest){
                secondLargest=nums[i];
            }
                        
        }
        return (largest-1)*(secondLargest-1);
    }
};
