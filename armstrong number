// Find the GCD of two numbers.
// Find the LCM of two numbers.
#include <iostream>
using namespace std;
#include <cmath>
int main() {
    int n=33333;
    int orig=n;
    int ans=0;
    int character=0;
    while(n>0){
        character++;
        n=n/10;
    }
    n=orig;
    while(n>0){
        int digit=n%10;
        
        ans=ans+pow(digit,character);
        n=n/10;
    }
    cout<<ans;
    
        
    
    return 0;
}
